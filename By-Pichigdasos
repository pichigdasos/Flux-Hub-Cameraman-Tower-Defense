function UI.onSaveSelected(value)
    if type(value) == "table" then
        value = value.Title or value[1]
    end
    if os.clock() - (UI.saveBornAt or 0) < 0.5 then
        return
    end
    if type(value) ~= "string" or value == Config.NoMacros then
        UI.notify("Save Macro", "Create a macro first, then select it here.", 5, "alert-triangle")
        return
    end
    local pending = State.Pending
    if not pending then
        UI.notify("Save Macro", "There is no recording to save.", 4, "alert-triangle")
        return
    end
    local count = Macros.save(value, pending)
    if not count then
        UI.notify("Save Macro", "Could not save the macro.", 4, "alert-triangle")
        return
    end
    State.Pending = nil
    Storage.remove(Paths.pending)
    Settings.data.selectedMacro = value
    Settings.save()
    UI.hideSaveDropdown()
    UI.notify("Macro Saved", string.format("%d actions saved to %s.", count, value), 5, "check")
    UI.refreshStatus()
end

