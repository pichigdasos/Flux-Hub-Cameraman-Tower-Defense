function Debug.log(...)
    local parts = {}
    for i = 1, select("#", ...) do
        parts[#parts + 1] = tostring((select(i, ...)))
    end
    local line = string.format("[%s] %s", os.date("%H:%M:%S"), table.concat(parts, " "))
    table.insert(Debug.lines, line)
    if #Debug.lines > 300 then
        table.remove(Debug.lines, 1)
    end
    if Debug.verbose then
        warn("[Flux Hub - CTD] " .. line)
    end
end

