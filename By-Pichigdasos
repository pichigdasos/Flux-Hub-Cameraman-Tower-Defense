function Util.clean(text)
    if type(text) ~= "string" then
        return ""
    end
    local s = text:gsub("<[^>]*>", "")
    s = s:lower()
    s = s:gsub("^%s+", "")
    s = s:gsub("%s+$", "")
    return s
end

function Util.cleanName(text)
    local s = tostring(text or "")
    s = s:gsub("[^%w _%-]", "")
    s = s:gsub("^%s+", "")
    s = s:gsub("%s+$", "")
    if #s > 40 then
        s = s:sub(1, 40)
    end
    return s
end

function Util.guiVisible(obj)
    local current = obj
    while current and current ~= PlayerGui do
        if current:IsA("GuiObject") then
            if not current.Visible then
                return false
            end
        elseif current:IsA("ScreenGui") then
            if not current.Enabled then
                return false
            end
        end
        current = current.Parent
    end
    return current == PlayerGui
end

function Util.pathOf(inst)
    if typeof(inst) ~= "Instance" then
        return nil
    end
    local segments = {}
    local current = inst
    while current and current ~= game do
        table.insert(segments, 1, current.Name)
        current = current.Parent
    end
    if current ~= game then
        return nil
    end
    return segments
end

function Util.resolvePath(segments)
    if type(segments) ~= "table" then
        return nil
    end
    local current = game
    for _, name in ipairs(segments) do
        local nextInstance = current:FindFirstChild(name)
        if not nextInstance and current == game then
            local ok, service = pcall(function()
                return game:GetService(name)
            end)
            if ok then
                nextInstance = service
            end
        end
        if not nextInstance then
            return nil
        end
        current = nextInstance
    end
    return current
end

function Util.pivot(inst)
    if typeof(inst) ~= "Instance" then
        return nil
    end
    if inst:IsA("PVInstance") then
        local ok, cframe = pcall(function()
            return inst:GetPivot()
        end)
        if ok and cframe then
            return cframe.Position
        end
    end
    return nil
end

function Util.flat(a, b)
    return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

function Util.describe(value)
    local kind = typeof(value)
    if kind == "Vector3" then
        return string.format("(%.1f, %.1f, %.1f)", value.X, value.Y, value.Z)
    elseif kind == "CFrame" then
        local p = value.Position
        return string.format("CF(%.1f, %.1f, %.1f)", p.X, p.Y, p.Z)
    elseif kind == "Instance" then
        return value:GetFullName()
    elseif kind == "table" then
        return "{table}"
    end
    return tostring(value)
end

function Util.describeArgs(args)
    local parts = {}
    for i = 1, args.n do
        parts[i] = Util.describe(args[i])
    end
    return table.concat(parts, ", ")
end

local function isArray(tbl)
    local n = 0
    for key in pairs(tbl) do
        if type(key) ~= "number" or key < 1 or key % 1 ~= 0 then
            return false, 0
        end
        if key > n then
            n = key
        end
    end
    for i = 1, n do
        if tbl[i] == nil then
            return false, 0
        end
    end
    return true, n
end

function Serializer.pack(value, ctx, depth, seen)
    local kind = typeof(value)
    if kind == "nil" then
        return {__t = "NIL"}
    elseif kind == "boolean" or kind == "string" then
        return value
    elseif kind == "number" then
        if value ~= value or value == math.huge or value == -math.huge then
            return 0
        end
        return value
    elseif kind == "Vector3" then
        return {__t = "V3", x = value.X, y = value.Y, z = value.Z}
    elseif kind == "Vector2" then
        return {__t = "V2", x = value.X, y = value.Y}
    elseif kind == "CFrame" then
        return {__t = "CF", c = {value:GetComponents()}}
    elseif kind == "Color3" then
        return {__t = "C3", r = value.R, g = value.G, b = value.B}
    elseif kind == "EnumItem" then
        local enumName = tostring(value.EnumType):gsub("^Enum%.", "")
        return {__t = "EN", e = enumName, n = value.Name}
    elseif kind == "Instance" then
        if value == LocalPlayer then
            return {__t = "LP"}
        end
        if LocalPlayer.Character and value == LocalPlayer.Character then
            return {__t = "LC"}
        end
        if ctx and ctx.towerRef then
            local ref = ctx.towerRef(value)
            if ref then
                return ref
            end
        end
        local path = Util.pathOf(value)
        if path then
            return {__t = "IN", p = path}
        end
        return {__t = "NIL"}
    elseif kind == "table" then
        if depth >= 6 or seen[value] then
            return {__t = "NIL"}
        end
        seen[value] = true
        local result
        local array, count = isArray(value)
        if array then
            local items = {}
            for i = 1, count do
                items[i] = Serializer.pack(value[i], ctx, depth + 1, seen)
            end
            result = {__t = "AR", n = count, v = items}
        else
            local entries = {}
            for key, item in pairs(value) do
                local keyType = type(key)
                if keyType == "string" or keyType == "number" then
                    table.insert(entries, {
                        Serializer.pack(key, ctx, depth + 1, seen),
                        Serializer.pack(item, ctx, depth + 1, seen),
                    })
                end
            end
            result = {__t = "DT", e = entries}
        end
        seen[value] = nil
        return result
    end
    return {__t = "NIL"}
end

function Serializer.unpack(value, ctx)
    if type(value) ~= "table" then
        return value
    end
    local tag = value.__t
    if tag == "NIL" then
        return nil
    elseif tag == "V3" then
        return Vector3.new(value.x, value.y, value.z)
    elseif tag == "V2" then
        return Vector2.new(value.x, value.y)
    elseif tag == "CF" then
        return CFrame.new(table.unpack(value.c))
    elseif tag == "C3" then
        return Color3.new(value.r, value.g, value.b)
    elseif tag == "EN" then
        local ok, item = pcall(function()
            return Enum[value.e][value.n]
        end)
        if ok then
            return item
        end
        return nil
    elseif tag == "LP" then
        return LocalPlayer
    elseif tag == "LC" then
        return LocalPlayer.Character
    elseif tag == "IN" then
        return Util.resolvePath(value.p)
    elseif tag == "TW" then
        if ctx and ctx.resolveTower then
            local inst = ctx.resolveTower(value)
            if inst then
                return inst
            end
        end
        return UNRESOLVED
    elseif tag == "AR" then
        local out = {}
        local count = value.n or #value.v
        for i = 1, count do
            local item = Serializer.unpack(value.v[i], ctx)
            if item == UNRESOLVED then
                return UNRESOLVED
            end
            out[i] = item
        end
        return out
    elseif tag == "DT" then
        local out = {}
        for _, pair in ipairs(value.e) do
            local key = Serializer.unpack(pair[1], ctx)
            local item = Serializer.unpack(pair[2], ctx)
            if item == UNRESOLVED then
                return UNRESOLVED
            end
            if key ~= nil then
                out[key] = item
            end
        end
        return out
    end
    return value
end

function Serializer.packArgs(args, ctx)
    local items = {}
    for i = 1, args.n do
        items[i] = Serializer.pack(args[i], ctx, 0, {})
    end
    return {n = args.n, v = items}
end

function Serializer.unpackArgs(packed, ctx)
    if type(packed) ~= "table" or type(packed.v) ~= "table" then
        return nil
    end
    local out = {n = packed.n or #packed.v}
    for i = 1, out.n do
        local item = Serializer.unpack(packed.v[i], ctx)
        if item == UNRESOLVED then
            return nil
        end
        out[i] = item
    end
    return out
end

function Remotes.isRemote(inst)
    return typeof(inst) == "Instance"
        and (inst:IsA("RemoteEvent") or inst:IsA("RemoteFunction") or inst:IsA("UnreliableRemoteEvent"))
end

function Remotes.resolve(action)
    if action.path then
        local inst = Util.resolvePath(action.path)
        if Remotes.isRemote(inst) then
            return inst
        end
    end
    for _, descendant in ipairs(ReplicatedStorage:GetDescendants()) do
        if descendant.Name == action.remote and Remotes.isRemote(descendant) then
            return descendant
        end
    end
    return nil
end

function Remotes.list()
    local out = {}
    for _, descendant in ipairs(ReplicatedStorage:GetDescendants()) do
        if Remotes.isRemote(descendant) then
            table.insert(out, descendant.ClassName .. " : " .. descendant:GetFullName())
        end
    end
    table.sort(out)
    return out
end

function Classify.kind(remote, args)
    local name = remote.Name:lower()
    local overrides = Settings.data.overrides
    for _, kind in ipairs({"place", "upgrade", "sell"}) do
        local custom = overrides[kind]
        if type(custom) == "string" and custom ~= "" and name == custom:lower() then
            return kind
        end
    end
    for _, kind in ipairs({"place", "upgrade", "sell"}) do
        for _, known in ipairs(Config.KnownNames[kind]) do
            if name == known then
                return kind
            end
        end
    end
    for _, kind in ipairs({"upgrade", "sell", "place"}) do
        for _, pattern in ipairs(Config.Patterns[kind]) do
            if name:find(pattern, 1, true) then
                return kind
            end
        end
    end
    local scoped = false
    for _, word in ipairs(Config.ScopeWords) do
        if name:find(word, 1, true) then
            scoped = true
        end
    end
    if scoped and type(args[1]) == "string" then
        local first = args[1]:lower()
        for kind, words in pairs(Config.ActionWords) do
            for _, word in ipairs(words) do
                if first == word then
                    return kind
                end
            end
        end
    end
    return nil
end

function Extract.findPosition(value, depth)
    local kind = typeof(value)
    if kind == "Vector3" then
        return value
    end
    if kind == "CFrame" then
        return value.Position
    end
    if kind == "table" and depth < 3 then
        for _, item in pairs(value) do
            local found = Extract.findPosition(item, depth + 1)
            if found then
                return found
            end
        end
    end
    return nil
end

function Extract.position(args)
    for i = 1, args.n do
        local found = Extract.findPosition(args[i], 0)
        if found then
            return found
        end
    end
    return nil
end

function Extract.isActionWord(text)
    local lower = text:lower()
    for _, words in pairs(Config.ActionWords) do
        for _, word in ipairs(words) do
            if lower == word then
                return true
            end
        end
    end
    return false
end

function Extract.unit(args)
    for i = 1, args.n do
        local value = args[i]
        if type(value) == "string" then
            if not Extract.isActionWord(value) then
                return value
            end
        elseif typeof(value) == "Instance" and value ~= LocalPlayer then
            return value.Name
        elseif type(value) == "table" then
            for _, key in ipairs({"Name", "Unit", "Tower", "Troop", "Type"}) do
                if type(value[key]) == "string" then
                    return value[key]
                end
            end
        end
    end
    return nil
end

function Towers.query(pos, radius)
    local ok, parts = pcall(function()
        local params = OverlapParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        local ignore = {}
        if LocalPlayer.Character then
            table.insert(ignore, LocalPlayer.Character)
        end
        params.FilterDescendantsInstances = ignore
        return workspace:GetPartBoundsInRadius(pos, radius, params)
    end)
    if ok and type(parts) == "table" then
        return parts
    end
    return {}
end

function Towers.snapshot(pos)
    local set = {}
    for _, part in ipairs(Towers.query(pos, Config.PlaceVerifyRadius)) do
        set[part] = true
    end
    return set
end

function Towers.appeared(pos, before)
    local now = Towers.snapshot(pos)
    if next(before) == nil and next(now) == nil then
        return nil
    end
    for part in pairs(now) do
        if not before[part] then
            return true
        end
    end
    return false
end

function Towers.resolveRef(ctx, ref)
    local cached = ctx.towers[ref.i]
    if cached and cached.Parent then
        return cached
    end
    local pos = ctx.positions[ref.i]
    if not pos then
        return nil
    end
    local best = nil
    local bestDistance = Config.TowerMatchRadius
    local function consider(inst)
        if not inst or ctx.claimed[inst] then
            return
        end
        if ref.cn and inst.ClassName ~= ref.cn then
            return
        end
        local p = Util.pivot(inst)
        if p then
            local distance = Util.flat(p, pos)
            if distance < bestDistance then
                best = inst
                bestDistance = distance
            end
        end
    end
    local container = nil
    if ref.pp then
        container = Util.resolvePath(ref.pp)
    end
    if container then
        for _, child in ipairs(container:GetChildren()) do
            consider(child)
        end
    end
    if not best and ref.nm then
        for _, part in ipairs(Towers.query(pos, Config.TowerMatchRadius)) do
            local candidate = part:FindFirstAncestor(ref.nm)
            if not candidate and part.Name == ref.nm then
                candidate = part
            end
            consider(candidate)
        end
    end
    if best then
        ctx.towers[ref.i] = best
        ctx.claimed[best] = ref.i
        return best
    end
    return nil
end

function Macros.path(name)
    return Paths.macros .. "/" .. name .. ".json"
end

function Macros.names()
    local names = Storage.list(Paths.macros)
    table.sort(names, function(a, b)
        return a:lower() < b:lower()
    end)
    return names
end

function Macros.exists(name)
    local lower = name:lower()
    for _, existing in ipairs(Macros.names()) do
        if existing:lower() == lower then
            return true
        end
    end
    return false
end

function Macros.create(name)
    Storage.ensureFolder(Paths.root)
    Storage.ensureFolder(Paths.macros)
    local macro = {version = 1, name = name, created = os.time(), actions = {}}
    return Storage.write(Macros.path(name), jsonEncode(macro) or "{}")
end

function Macros.load(name)
    local raw = Storage.read(Macros.path(name))
    if not raw then
        return nil
    end
    local data = jsonDecode(raw)
    if type(data) ~= "table" then
        return nil
    end
    if type(data.actions) ~= "table" then
        data.actions = {}
    end
    return data
end

function Macros.save(name, pending)
    local macro = Macros.load(name) or {version = 1, name = name, created = os.time(), actions = {}}
    macro.actions = pending.actions
    macro.updated = os.time()
    macro.placeId = pending.placeId
    local text = jsonEncode(macro)
    if not text then
        return nil
    end
    Storage.ensureFolder(Paths.root)
    Storage.ensureFolder(Paths.macros)
    Storage.write(Macros.path(name), text)
    return #macro.actions
end

function Macros.delete(name)
    Storage.remove(Macros.path(name))
end

function Recorder.reset()
    Recorder.actions = {}
    Recorder.places = {}
    Recorder.recent = {}
end

function Recorder.begin()
    if State.Recording then
        return
    end
    State.Recording = true
    Recorder.t0 = State.MatchStart or os.clock()
    Debug.log("Recording started")
end

function Recorder.arm()
    Recorder.reset()
    State.Armed = true
    State.Recording = false
    Settings.data.recordArmed = true
    Settings.save()
    if State.InMatch then
        Recorder.begin()
    end
end

function Recorder.disarm()
    State.Armed = false
    State.Recording = false
    Settings.data.recordArmed = false
    Settings.save()
end

function Recorder.refFor(inst)
    local p = Util.pivot(inst)
    if not p then
        return nil
    end
    local bestIndex = nil
    local bestDistance = Config.TowerMatchRadius
    for i = #Recorder.places, 1, -1 do
        local place = Recorder.places[i]
        if place.pos and not place.sold then
            local distance = Util.flat(p, place.pos)
            if distance < bestDistance then
                bestIndex = i
                bestDistance = distance
            end
        end
    end
    if not bestIndex then
        return nil
    end
    return {
        __t = "TW",
        i = bestIndex,
        cn = inst.ClassName,
        nm = inst.Name,
        pp = Util.pathOf(inst.Parent),
    }
end

function Recorder.remember(text)
    table.insert(Recorder.recent, text)
    while #Recorder.recent > 4 do
        table.remove(Recorder.recent, 1)
    end
end

function Recorder.capture(remote, method, args)
    if not Remotes.isRemote(remote) then
        return
    end
    local kind = Classify.kind(remote, args)
    if Debug.logRemotes then
        Debug.log("Remote", remote.Name, method, tostring(kind), Util.describeArgs(args))
    end
    if not State.Recording or not kind then
        return
    end
    local entry = {
        t = math.max(0, os.clock() - Recorder.t0),
        kind = kind,
        remote = remote.Name,
        path = Util.pathOf(remote),
        method = method,
    }
    local label = "Placed"
    local unit = nil
    local pos = nil
    if kind == "place" then
        pos = Extract.position(args)
        unit = Extract.unit(args)
        table.insert(Recorder.places, {pos = pos, unit = unit, sold = false})
        entry.idx = #Recorder.places
        entry.unit = unit
        if pos then
            entry.pos = {pos.X, pos.Y, pos.Z}
        end
        entry.args = Serializer.packArgs(args, nil)
    else
        local ctx = {}
        ctx.towerRef = function(inst)
            local ref = Recorder.refFor(inst)
            if ref and not ctx.firstIndex then
                ctx.firstIndex = ref.i
            end
            return ref
        end
        entry.args = Serializer.packArgs(args, ctx)
        entry.idx = ctx.firstIndex
        local place = ctx.firstIndex and Recorder.places[ctx.firstIndex] or nil
        if place then
            unit = place.unit
            pos = place.pos
            entry.unit = unit
            if kind == "sell" then
                place.sold = true
            end
        end
        if kind == "upgrade" then
            label = "Upgraded"
        else
            label = "Sold"
        end
    end
    table.insert(Recorder.actions, entry)
    local where = ""
    if pos then
        where = " " .. Util.describe(pos)
    end
    local text = string.format("%s %s%s", label, unit or "troop", where)
    Recorder.remember(text)
    Debug.log("Recorded", text)
    UI.refreshStatus()
end

function Recorder.finish(reason)
    local actions = Recorder.actions
    Recorder.disarm()
    UI.setRecordToggle(false)
    local count = #actions
    if reason == "round" then
        warn("End Of Round: Ready")
    end
    if count == 0 then
        if reason == "round" then
            UI.notify("End Of Round: Ready", "No troop actions were recorded this round.", 6, "alert-triangle")
        else
            UI.notify("Recording Stopped", "No troop actions were recorded.", 4, "alert-triangle")
        end
        UI.refreshStatus()
        return
    end
    State.Pending = {version = 1, placeId = game.PlaceId, recorded = os.time(), actions = actions}
    local text = jsonEncode(State.Pending)
    if text then
        Storage.write(Paths.pending, text)
    end
    local title = "Recording Stopped"
    if reason == "round" then
        title = "End Of Round: Ready"
    end
    UI.notify(
        title,
        string.format("%d actions recorded. Select your macro under Record Macro to save them.", count),
        8,
        "check"
    )
    UI.showSaveDropdown()
    UI.refreshStatus()
end

function Player.stop(reason)
    if Player.running then
        Debug.log("Playback stopped", tostring(reason))
    end
    Player.running = false
    Player.token = Player.token + 1
end

function Player.waitUntil(deadline, token)
    while os.clock() < deadline do
        if token ~= Player.token or not Alive then
            return false
        end
        task.wait(math.clamp(deadline - os.clock(), 0.03, 0.25))
    end
    return token == Player.token and Alive
end

function Player.newContext()
    local ctx = {
        towers = {},
        positions = {},
        claimed = setmetatable({}, {__mode = "k"}),
    }
    ctx.resolveTower = function(ref)
        return Towers.resolveRef(ctx, ref)
    end
    return ctx
end

function Player.fire(remote, args)
    Player.firing = true
    local ok, err = pcall(function()
        if remote:IsA("RemoteFunction") then
            return remote:InvokeServer(table.unpack(args, 1, args.n))
        end
        return remote:FireServer(table.unpack(args, 1, args.n))
    end)
    Player.firing = false
    if not ok then
        Debug.log("Fire error", err)
    end
    return ok
end

function Player.confirmPlacement(pos, before, token)
    local deadline = os.clock() + Config.PlaceConfirmTime
    while os.clock() < deadline do
        if token ~= Player.token then
            return false
        end
        task.wait(0.2)
        local verdict = Towers.appeared(pos, before)
        if verdict ~= false then
            return true
        end
    end
    return false
end

function Player.resolveArgs(action, ctx, token)
    local deadline = os.clock() + Config.ResolveTimeout
    while true do
        local args = Serializer.unpackArgs(action.args, ctx)
        if args then
            return args
        end
        if os.clock() >= deadline or token ~= Player.token then
            return nil
        end
        task.wait(0.3)
    end
end

function Player.execute(action, ctx, token)
    local remote = Remotes.resolve(action)
    if not remote then
        Debug.log("Remote not found", tostring(action.remote))
        return
    end
    if action.kind == "place" then
        local pos = nil
        if type(action.pos) == "table" and #action.pos == 3 then
            pos = Vector3.new(action.pos[1], action.pos[2], action.pos[3])
        end
        if action.idx then
            ctx.positions[action.idx] = pos
        end
        local args = Serializer.unpackArgs(action.args, ctx)
        if not args then
            return
        end
        for attempt = 1, Config.PlaceRetries do
            if token ~= Player.token then
                return
            end
            local before = {}
            if pos then
                before = Towers.snapshot(pos)
            end
            Player.fire(remote, args)
            if not pos or Player.confirmPlacement(pos, before, token) then
                return
            end
            Debug.log("Placement retry", tostring(action.unit), attempt)
            if not Player.waitUntil(os.clock() + Config.PlaceRetryDelay, token) then
                return
            end
        end
        Debug.log("Placement failed", tostring(action.unit))
        return
    end
    local args = Player.resolveArgs(action, ctx, token)
    if not args then
        Debug.log("Skipped " .. tostring(action.kind) .. ": tower not found")
        return
    end
    Player.fire(remote, args)
end

function Player.start(name)
    local macro = Macros.load(name)
    if not macro or #macro.actions == 0 then
        UI.notify("Playback", "That macro has no recorded actions.", 4, "alert-triangle")
        return false
    end
    Player.stop("restart")
    Player.running = true
    Player.token = Player.token + 1
    local token = Player.token
    Player.name = name
    Player.total = #macro.actions
    Player.progress = 0
    local ctx = Player.newContext()
    UI.notify("Playback", "Running macro: " .. name, 3, "play")
    task.spawn(function()
        local origin = State.MatchStart or os.clock()
        for index, action in ipairs(macro.actions) do
            local due = origin + (tonumber(action.t) or 0)
            if not Player.waitUntil(due, token) then
                return
            end
            local ok, err = pcall(Player.execute, action, ctx, token)
            if not ok then
                Debug.log("Playback error", err)
            end
            Player.progress = index
            if not Player.waitUntil(os.clock() + Config.MinActionGap, token) then
                return
            end
        end
        if token == Player.token then
            Player.running = false
            UI.notify("Playback", "Macro finished: " .. name, 4, "check")
        end
    end)
    return true
end

