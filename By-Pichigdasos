Shared.handler = function(remote, method, args)
    if not Alive or Player.firing then
        return
    end
    if type(checkcaller) == "function" and checkcaller() then
        return
    end
    if not (State.Recording or Debug.logRemotes) then
        return
    end
    task.spawn(function()
        local ok, err = pcall(Recorder.capture, remote, method, args)
        if not ok then
            Debug.log("Capture error", tostring(err))
        end
    end)
end

Shared.destroy = function()
    Alive = false
    State.Recording = false
    State.Armed = false
    Player.stop("unload")
    Shared.handler = nil
    for _, connection in ipairs(Connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end
    if UI.window then
        pcall(function()
            UI.window:Destroy()
        end)
    end
end

