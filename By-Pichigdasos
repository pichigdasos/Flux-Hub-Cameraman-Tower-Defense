function UI.onPlayNow()
    local name = Settings.data.selectedMacro
    if name == "" then
        UI.notify("Playback", "Select a macro first.", 4, "alert-triangle")
        return
    end
    if not State.InMatch then
        UI.notify("Playback", "Join a match first.", 4, "alert-triangle")
        return
    end
    State.PlayedThisMatch = true
    Player.start(name)
end

function UI.refreshStatus()
    local counts = {place = 0, upgrade = 0, sell = 0}
    for _, action in ipairs(Recorder.actions) do
        counts[action.kind] = (counts[action.kind] or 0) + 1
    end
    local area = "Lobby"
    if State.InMatch then
        area = "Match"
    end
    local recording = "Off"
    if State.Recording then
        recording = "ON"
    elseif State.Armed then
        recording = "Armed, waiting for match"
    end
    local lines = {
        string.format("Area: %s | Wave: %d | Recording: %s", area, State.Wave, recording),
        string.format("Placed: %d | Upgraded: %d | Sold: %d", counts.place, counts.upgrade, counts.sell),
    }
    for _, line in ipairs(Recorder.recent) do
        table.insert(lines, line)
    end
    if State.Pending then
        table.insert(lines, string.format("Unsaved recording: %d actions", #State.Pending.actions))
    end
    UI.setDesc("recordStatus", table.concat(lines, "\n"))
    local playback = "Idle"
    if Player.running then
        playback = string.format("Running %s: step %d of %d", tostring(Player.name), Player.progress, Player.total)
    end
    UI.setDesc("playStatus", playback)
end

function UI.loadLibrary()
    local urls = {
        "https://github.com/Footagesus/WindUI/releases/latest/download/main.lua",
        "https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua",
    }
    for _, url in ipairs(urls) do
        local ok, library = pcall(function()
            return loadstring(game:HttpGet(url))()
        end)
        if ok and type(library) == "table" then
            return library
        end
    end
    return nil
end

