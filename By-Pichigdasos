function GuiTools.climb(obj)
    if obj:IsA("GuiButton") then
        return obj
    end
    local center = obj.AbsolutePosition + obj.AbsoluteSize / 2
    local level = obj.Parent
    local depth = 0
    while level and level ~= PlayerGui and depth < 5 do
        if level:IsA("GuiButton") and Util.guiVisible(level) then
            return level
        end
        local best = nil
        local bestArea = nil
        for _, descendant in ipairs(level:GetDescendants()) do
            if descendant:IsA("GuiButton") and Util.guiVisible(descendant) then
                local p = descendant.AbsolutePosition
                local s = descendant.AbsoluteSize
                if center.X >= p.X and center.X <= p.X + s.X and center.Y >= p.Y and center.Y <= p.Y + s.Y then
                    local area = s.X * s.Y
                    if not bestArea or area < bestArea then
                        best = descendant
                        bestArea = area
                    end
                end
            end
        end
        if best then
            return best
        end
        level = level.Parent
        depth = depth + 1
    end
    return nil
end

function GuiTools.click(button)
    if not VirtualInputManager then
        return false
    end
    local position = button.AbsolutePosition
    local size = button.AbsoluteSize
    local x = position.X + size.X / 2
    local y = position.Y + size.Y / 2
    local screen = button:FindFirstAncestorOfClass("ScreenGui")
    if screen and not screen.IgnoreGuiInset then
        local inset = GuiService:GetGuiInset()
        y = y + inset.Y
    end
    local ok = pcall(function()
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
    end)
    return ok
end

function GuiTools.press(button)
    if not button or not button:IsA("GuiButton") then
        return false
    end
    local fired = false
    if type(firesignal) == "function" then
        for _, name in ipairs({"Activated", "MouseButton1Click"}) do
            local ok = pcall(function()
                firesignal(button[name])
            end)
            if ok then
                fired = true
            end
        end
    end
    if not fired and type(getconnections) == "function" then
        for _, name in ipairs({"Activated", "MouseButton1Click"}) do
            local ok, connections = pcall(function()
                return getconnections(button[name])
            end)
            if ok and type(connections) == "table" then
                for _, connection in ipairs(connections) do
                    pcall(function()
                        if connection.Fire then
                            connection:Fire()
                        elseif connection.Function then
                            connection.Function()
                        end
                    end)
                    fired = true
                end
            end
        end
    end
    if not fired then
        fired = GuiTools.click(button)
    end
    return fired
end

function GuiTools.findByText(predicate)
    for obj in pairs(GuiWatch.texts) do
        if obj.Parent and obj.Text ~= "" and Util.guiVisible(obj) then
            local text = Util.clean(obj.Text)
            if text ~= "" and #text <= 32 and predicate(text) then
                local button = GuiTools.climb(obj)
                if button then
                    return button
                end
            end
        end
    end
    return nil
end

function Vote.find(selected)
    local seen = {}
    local seenCount = 0
    local target = nil
    for obj in pairs(GuiWatch.texts) do
        if obj.Parent and obj.Text ~= "" and Util.guiVisible(obj) then
            local text = Util.clean(obj.Text)
            if text ~= "" and #text <= 32 then
                for group, aliases in pairs(Config.DifficultyAliases) do
                    for _, alias in ipairs(aliases) do
                        if text:find("^" .. alias .. "%f[%A]") then
                            if not seen[group] then
                                seen[group] = true
                                seenCount = seenCount + 1
                            end
                            if group == selected and not target then
                                target = obj
                            end
                        end
                    end
                end
            end
        end
    end
    if seenCount < 2 then
        return nil, false
    end
    if not target then
        return nil, true
    end
    return GuiTools.climb(target), true
end

function Detect.scan()
    local result = {wave = nil, endHit = false}
    for obj in pairs(GuiWatch.texts) do
        if obj.Parent and obj.Text ~= "" and Util.guiVisible(obj) then
            local text = Util.clean(obj.Text)
            if text ~= "" and #text <= 48 then
                local waveText = text:match("wave%s*:?%s*(%d+)")
                if waveText then
                    local number = tonumber(waveText)
                    if number and (not result.wave or number > result.wave) then
                        result.wave = number
                    end
                end
                if not result.endHit then
                    for _, title in ipairs(Config.EndTitles) do
                        if text:match("^" .. title .. "[%s%p]*$") then
                            result.endHit = true
                            break
                        end
                    end
                end
            end
        end
    end
    return result
end

function Detect.onMatchBegin(startAt)
    State.MatchStart = startAt or os.clock()
    State.RoundEnded = false
    State.ReplayPressed = false
    State.EndShownSince = nil
    State.PlayedThisMatch = false
    Player.stop("new match")
    if State.Armed then
        Recorder.begin()
    end
    Debug.log("Match started")
end

function Detect.onRoundEnd()
    Debug.log("Round ended")
    Player.stop("round ended")
    if State.Armed then
        Recorder.finish("round")
    end
end

function Detect.update()
    local result = Detect.scan()
    local now = os.clock()
    local previousWave = State.Wave
    State.Wave = result.wave or 0
    State.EndVisible = result.endHit

    local inMatchRaw = result.wave ~= nil or game.PlaceId ~= Config.LobbyPlaceId
    if inMatchRaw then
        State.LastMatchSeen = now
        if not State.InMatch then
            State.InMatch = true
            State.SawMatch = true
            Detect.onMatchBegin()
        elseif result.wave ~= nil and previousWave >= 3 and result.wave <= 1 and not result.endHit then
            Detect.onMatchBegin()
        end
    elseif State.InMatch and now - State.LastMatchSeen > 3 then
        State.InMatch = false
        State.SawMatch = false
    end

    if result.endHit then
        State.EndClearSince = nil
        if State.SawMatch and not State.RoundEnded then
            State.RoundEnded = true
            State.EndShownSince = now
            Detect.onRoundEnd()
        end
    else
        State.EndClearSince = State.EndClearSince or now
        if State.RoundEnded and now - State.EndClearSince > 3 then
            State.RoundEnded = false
            State.EndShownSince = nil
            State.ReplayPressed = false
            if State.InMatch then
                Detect.onMatchBegin(State.EndClearSince)
            end
        end
    end
end

function Automation.tick()
    local now = os.clock()
    local data = Settings.data

    if data.autoVote then
        local button, voteVisible = Vote.find(data.difficulty)
        if voteVisible then
            State.VoteGoneSince = nil
            if button and (not State.Voted or now - State.VoteAttemptAt > 6) then
                State.VoteAttemptAt = now
                if GuiTools.press(button) then
                    State.Voted = true
                    Debug.log("Voted", data.difficulty)
                end
            end
        elseif State.Voted then
            State.VoteGoneSince = State.VoteGoneSince or now
            if now - State.VoteGoneSince > 3 then
                State.Voted = false
                State.VoteGoneSince = nil
            end
        end
    end

    if data.autoReplay and State.RoundEnded and State.EndVisible and not State.ReplayPressed then
        if State.EndShownSince and now - State.EndShownSince >= 3 then
            local button = GuiTools.findByText(function(text)
                return text == "play again"
            end)
            if button and GuiTools.press(button) then
                State.ReplayPressed = true
                Debug.log("Replay pressed")
            end
        end
    end

    if data.autoSkip and State.InMatch and not State.RoundEnded and now - State.LastSkip > 3 then
        local button = GuiTools.findByText(function(text)
            return text:match("^skip") ~= nil
        end)
        if button then
            State.LastSkip = now
            GuiTools.press(button)
        end
    end

    if data.playMacro and State.InMatch and not State.RoundEnded and not State.PlayedThisMatch and not Player.running then
        if data.selectedMacro ~= "" then
            State.PlayedThisMatch = true
            Player.start(data.selectedMacro)
        end
    end
end

