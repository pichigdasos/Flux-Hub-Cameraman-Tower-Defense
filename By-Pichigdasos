function Hook.install()
    if Shared.hookInstalled then
        Hook.available = true
        return true
    end
    if type(hookmetamethod) ~= "function" or type(getnamecallmethod) ~= "function" then
        return false
    end
    local wrap = newcclosure
    if type(wrap) ~= "function" then
        wrap = function(callback)
            return callback
        end
    end
    local original
    original = hookmetamethod(game, "__namecall", wrap(function(self, ...)
        local method = getnamecallmethod()
        if method == "FireServer" or method == "InvokeServer" then
            local handler = Shared.handler
            if handler then
                pcall(handler, self, method, table.pack(...))
            end
        end
        return original(self, ...)
    end))
    Shared.hookInstalled = true
    Hook.available = true
    return true
end

